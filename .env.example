# 复制成 .env，填上你自己的 key，再重启后端（npm run dev）。
# .env 已被 .gitignore 忽略，不会提交，放心填。
# 一个都不填也行 —— 后端会进 mock 模式，回假消息，方便先调界面。

# DeepSeek：https://platform.deepseek.com/  默认模型 deepseek-chat
DEEPSEEK_API_KEY=

# Gemini：https://aistudio.google.com/apikey  默认模型 gemini-2.5-flash
GEMINI_API_KEY=

# OpenAI（GPT-4o / o3 等）：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ===== 家版：接本机 Codex CLI（ChatGPT Plus/Pro 订阅额度，不走 API key）=====
# 在 VPS 上安装 Codex CLI，然后运行 `codex login` 用你的 ChatGPT Plus/Pro 账号登录。
# 聊天页里的「Codex 5.5T」会调用：codex exec --model gpt-5.5
# 不填 OPENAI_API_KEY；如果 VPS 没登录 Codex CLI，这项会报“请先登录 Codex”。
CODEX_CLI_MODEL=gpt-5.5
# 一般不用改；需要指定 Codex CLI 工作目录时再填。
CODEX_CLI_CWD=

# Anthropic（Claude · Sonnet/Opus）：https://console.anthropic.com/  默认模型 claude-sonnet-4-6
# 这是「按 token 付费」的 API key。想用 Claude 又不想买 API，就用下面的「家版」。
ANTHROPIC_API_KEY=

# ===== 家版：接本机 Claude Code（订阅额度，不按 API 计费）=====
# 在这台机器上先 `npm i -g @anthropic-ai/claude-code` 再 `claude setup-token`
# （浏览器登录你的 Pro/Max），把生成的一年期令牌贴这里。
# 填了之后，聊天页就能选「家克·Opus 4.6/4.7/4.8（CC）」；不填则那几项进 mock。
# ⚠️ 订阅令牌只给你自己用，别公开这个网址给别人/粉丝用（踩条款有封号风险）。
CLAUDE_CODE_OAUTH_TOKEN=

# ===== 棠予酿记忆库（本机 stdio MCP，只给家克 CC 调用）=====
# 连接不再使用公网 MCP/OAuth；proxy 在 VPS 本机 spawn server/tangMemoryMcp.mjs，
# 再复用下方 TANG_INTERNAL_KEY 访问 8890。MCP server name 固定为 tang_memory，
# 确保 Claude CLI 能稳定匹配四个预授权工具。

# ElevenLabs：AI 给你发语音的音色。https://elevenlabs.io/
# 不填就用 mock（一段哔声占位）；填了猫咪的语音就是你选的音色。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 默认 eleven_multilingual_v2（中文也行），一般不用改
ELEVENLABS_MODEL=eleven_multilingual_v2

# ===== 他的歌单 · Spotify 真播放 =====
# 在 https://developer.spotify.com/dashboard 建一个 Web API app，回调地址必须逐字一致。
# 房间界面、极光和星雨不填也能预览；填好并用 Premium 登录后才会播放完整歌曲。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://nekopurrs.uk/api/spotify/callback
# OAuth session 默认写在 server/data/spotify-sessions.json；通常不用改。
# SPOTIFY_SESSION_PATH=

# ===== 呼噜频道 · 真后台自动唤醒（Web Push）=====
# VAPID 密钥首次启动会自动生成到 server/data/autowake/vapid.json，无需手填。
AUTOWAKE_TIME_ZONE=Asia/Kuching
AUTOWAKE_QUIET_START=02:30
AUTOWAKE_QUIET_END=08:30
AUTOWAKE_MIN_IDLE_MINUTES=60
AUTOWAKE_MIN_GAP_MINUTES=120
AUTOWAKE_MAX_GAP_MINUTES=240
AUTOWAKE_MAX_PER_DAY=5
# AUTOWAKE_VAPID_SUBJECT=mailto:you@example.com
# AUTOWAKE_DATA_DIR=/var/www/codeandpurrs/server/data/autowake
# AUTOWAKE_LOG=/var/log/codeandpurrs/autowake.log

# 后端代理端口（不改就用 8787，要改的话 vite.config.ts 里的 proxy 也要跟着改）
PORT=8787

# ===== Neko Usage Bridge（猫爪足迹后端，独立进程 npm run bridge:start）=====
# 红米桥接上报用的共享密钥；留空 = 不校验（仅本机调试用，线上务必填长随机串）
USAGE_BRIDGE_TOKEN=
# bridge 监听端口（和聊天后端 8787 分开）
BRIDGE_PORT=8788
# 允许跨域读取的前端域名（逗号分隔）；* 仅调试用
USAGE_BRIDGE_ALLOWED_ORIGINS=https://nekopurrs.uk,https://api.nekopurrs.uk
# 落盘数据保留天数；0 = 不自动清理
USAGE_BRIDGE_RETENTION_DAYS=60
# 落盘目录（默认 server/data/usage/），一般不用改
# USAGE_BRIDGE_DATA_DIR=

# ===== Purr Channel · 手机屏幕共享（由 Neko Usage Bridge 主动授权）=====
# 上传沿用 USAGE_BRIDGE_TOKEN；网页读取沿用 CHAT_SAVE_KEY，不向前端暴露 bridge token。
# 服务器只保留最新一帧，超过这个秒数自动失效。
SCREEN_FRAME_TTL_SECONDS=60
# SCREEN_FRAME_DATA_DIR=/var/www/codeandpurrs/server/data/screen
