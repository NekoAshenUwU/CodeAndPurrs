# DRAFT ONLY: approval, DNS, certificate, and verified github auth are required.
# Do not proxy private mode. First verify healthz auth_mode=github and MCP 401.
server {
    listen 80;
    server_name wake-mcp.nekopurrs.uk;
    location /.well-known/acme-challenge/ {
        root /var/lib/neko-native-wake-acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name wake-mcp.nekopurrs.uk;
    ssl_certificate /etc/letsencrypt/live/wake-mcp.nekopurrs.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wake-mcp.nekopurrs.uk/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:8894;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
