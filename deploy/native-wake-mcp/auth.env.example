# Template only. Store real values in /etc/neko-native-wake.env, mode 0600.
# Never expose the service publicly until github auth has been verified locally.
NEKO_NATIVE_WAKE_AUTH_MODE=github
NEKO_NATIVE_WAKE_PUBLIC_URL=https://wake-mcp.nekopurrs.uk
NEKO_NATIVE_WAKE_GITHUB_OWNER=NekoAshenUwU
NEKO_NATIVE_WAKE_GITHUB_CLIENT_ID=REPLACE_WITH_NEW_APP_CLIENT_ID
NEKO_NATIVE_WAKE_GITHUB_CLIENT_SECRET=REPLACE_WITH_NEW_APP_CLIENT_SECRET
NEKO_NATIVE_WAKE_JWT_SIGNING_KEY=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
